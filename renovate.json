{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>brave/renovate-config"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "enabled": true
    },
    {
      "matchFileNames": ["site/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "site dependencies",
      "groupSlug": "site"
    },
    {
      "matchFileNames": ["site/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "site dependencies (major)",
      "groupSlug": "site-major"
    }
  ]
}
